# Admin
POSTAMATS_ADMIN_LOGIN=admin
POSTAMATS_ADMIN_PASSWORD=admin
POSTAMATS_ADMIN_NAME=Администратор

APP_RUNTIME_DIR=runtime

# Printer
PRINTER=HP_LaserJet_M406_B14F90

WEB_HOST=127.0.0.1
WEB_PORT=8000

# Debug
ALLOW_DEBUG_COMMANDS=0
REJECT_BIN_CAPACITY=50

POSTAMATS_DB_URL=sqlite:///./app.db

#mock#hybrid
IO_BACKEND=mock
#IO_BACKEND=hybrid

#POSTAMATS NODES
#OPCUA_ENDPOINT=opc.tcp://192.168.7.11:4840
OPCUA_ENDPOINT=opc.tcp://192.168.7.1:4840
OPCUA_NODE_SAFETY="ns=4;s=|var|PLC210 OPC-UA.Application.SZC_ES.ESok"
OPCUA_NODE_TRASHCAN_PRESENT="ns=4;s=|var|PLC210 OPC-UA.Application.Status.Trashcan"
OPCUA_NODE_SAFETY_STATUS="ns=4;s=|var|PLC210 OPC-UA.Application.SZC_ES.ES_status"

OPCUA_NODE_STACKLIGHT_STATE_CMD="ns=4;s=|var|PLC210 OPC-UA.Application.SZC_ES.color"
OPCUA_NODE_SOUND_STATE_CMD="ns=4;s=|var|PLC210 OPC-UA.Application.SZC_ES.sound"
OPCUA_NODE_STACKLIGHT_STATE_STATUS="ns=4;s=|var|PLC210 OPC-UA.Application.SZC_ES.color_status"
OPCUA_NODE_SOUND_STATE_STATUS="ns=4;s=|var|PLC210 OPC-UA.Application.SZC_ES.sound_status"

OPCUA_NODE_TEMPERATURE_SENSOR_LOADING="ns=4;s=|var|PLC210 OPC-UA.Application.AInput.T_1"
OPCUA_NODE_TEMPERATURE_SENSOR_IM="ns=4;s=|var|PLC210 OPC-UA.Application.AInput.T_2"

OPCUA_NODE_LOADING_DOOR_CMD_FMT="ns=4;s=|var|PLC210 OPC-UA.Application.LDoor.ILD{idx}"
OPCUA_NODE_LOADING_DOOR_STAT_FMT="ns=4;s=|var|PLC210 OPC-UA.Application.Status.Stat_DL{idx}"
OPCUA_NODE_UNLOADING_DOOR_CMD_FMT="ns=4;s=|var|PLC210 OPC-UA.Application.UDoor.IUD{idx}"
OPCUA_NODE_UNLOADING_DOOR_STAT_FMT="ns=4;s=|var|PLC210 OPC-UA.Application.Status.Stat_DU{idx}"
OPCUA_NODE_LOADING_COL_SENSOR_FMT="ns=4;s=|var|PLC210 OPC-UA.Application.Status.OSL_{col}"
OPCUA_NODE_UNLOADING_COL_SENSOR_FMT="ns=4;s=|var|PLC210 OPC-UA.Application.Status.OSU_{col}"

OPCUA_LOADING_CELLS="1-16"
OPCUA_UNLOADING_CELLS="1-16"
OPCUA_LOADING_COLS="1-3"
OPCUA_UNLOADING_COLS="1-4"

#IM NODES
OPCUA_ENDPOINT_IM=opc.tcp://192.168.7.130:4840

IM_NODE_CLEAR_DB="ns=1;s=ActorOpcUaServerNode-controll.clear_db"
IM_NODE_VACUUM="ns=1;s=ActorOpcUaServerNode-controll.vaacum"
IM_NODE_VACUUM_STATE="ns=1;s=ActorOpcUaServerNode-controll.vaacumState"
IM_NODE_CALIBRATE="ns=1;s=ActorOpcUaServerNode-controll.calibrate"
IM_NODE_REMAINING_CALIB_ITER="ns=1;s=ActorOpcUaServerNode-controll.remainingCalibIter"
IM_NODE_MEASURE_START="ns=1;s=ActorOpcUaServerNode-controll.pril1_start"
IM_NODE_MEASURE_STATE="ns=1;s=ActorOpcUaServerNode-controll.measureState"
IM_NODE_SCHEME_IFACE="ns=1;s=SchemeInterface"
IM_NODE_SCHEME_LOAD_METHOD="ns=1;i=20008"


# RTK service
RTK_BACKEND=mock
# RTK_BACKEND=http
# RTK_BASE_URL=http://172.27.208.1:8080/
# RTK_PREFIX=api/master
# RTK_TIMEOUT_SEC=2.0


